# 1. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. (Optional) Which Gemini model to use
GEMINI_MODEL=gemini-flash-latest

# 3. (Optional) Use an existing wallet for the agent (private key, 0x...).
#    Leave empty and use the "Create wallet" button on the page instead.
#    Use a TEST wallet only. Never put a wallet with real money here.
WALLET_PRIVATE_KEY=

# x402 payments (Base Sepolia testnet only)
# Set to a receiving wallet address you control; never put a private key here.
X402_PAY_TO=
X402_PRICE='$0.01'
# Optional; defaults to https://x402.org/facilitator
# X402_FACILITATOR_URL=
